---
// src/pages/saantayo.astro — Saan Tayo? case study
//
// All copy lives in src/data/saantayo.js — read the note at the top of that
// file before editing any of it. In particular: the repo is private, so this
// page links to the live site only, and the figures in the agreement table
// are agreement with an AI-assisted reference set, never "accuracy".
import BaseLayout from "../layouts/BaseLayout.astro";
import KeyScreenCard from "../components/KeyScreenCard.astro";
import ZoomShot from "../components/ZoomShot.astro";
import ZoomDialog from "../components/ZoomDialog.astro";
import { saantayo as cs } from "../data/saantayo.js";
import { profile } from "../data/profile.js";

const description =
  "How Saan Tayo? tags all 1,642 Philippine cities and municipalities by vibe from open data: the pipeline, what the tags agree with, the redesign, and where it falls short.";

const sectionLabel =
  "mb-5 text-[11px] font-bold uppercase tracking-[0.22em] text-faint";
const panelLabel =
  "mb-3 text-[11px] font-bold uppercase tracking-[0.22em] text-accent";
const subLabel =
  "mb-3.5 text-[11px] font-bold uppercase tracking-[0.22em] text-faint";

// Padding is kept out of `panelBase` so a panel that wants its own can set it
// without a conflict — see the same note in kkevents.astro.
const panelBase = "rounded-[16px] border border-line bg-card";
const panel = `${panelBase} p-5 sm:p-6`;

const liveHost = new URL(cs.live).host.replace(/^www\./, "");

// Structured data. Everything below is already stated on the page.
const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: cs.title,
    description,
    url: pageURL,
    image: new URL(cs.og.image, Astro.site).toString(),
    inLanguage: "en",
    keywords: cs.stack.chips.join(", "),
    author: {
      "@type": "Person",
      name: profile.fullName,
      url: new URL("/", Astro.site).toString(),
    },
    about: {
      "@type": "WebSite",
      name: "Saan Tayo?",
      url: cs.live,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Projects",
        item: new URL("/#projects", Astro.site).toString(),
      },
      // Last crumb carries no `item`: it is the page you are already on.
      { "@type": "ListItem", position: 2, name: "Saan Tayo?" },
    ],
  },
];
---

<BaseLayout
  title="Saan Tayo? — Case Study | Carlos Natanauan"
  description={description}
  navBase="/"
  ogType="article"
  ogImage={cs.og.image}
  ogImageAlt="Saan Tayo? Every town in the Philippines, sorted by vibe."
  ogImageWidth={cs.og.width}
  ogImageHeight={cs.og.height}
  twitterCard="summary_large_image"
  personSchema={false}
  schema={schema}
>
  <!-- Set before the content below is parsed, so the first paint already has
       the reveal state and nothing flashes in and back out. Gated on IO
       existing: without it the CSS never hides anything. -->
  <script is:inline>
    if ("IntersectionObserver" in window) {
      document.documentElement.classList.add("reveal-ready");
    }
  </script>

  <div class="read-progress" aria-hidden="true"></div>

  <article class="col pt-6 pb-16 sm:pt-9 sm:pb-20">
    <!-- ── Header ─────────────────────────────────────────────── -->
    <a
      href="/#projects"
      class="inline-flex items-center gap-1.5 text-[13.5px] font-medium text-muted transition-colors hover:text-accent-hover"
    >
      <svg
        class="h-3.5 w-3.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7"></path>
        <path d="M19 12H5"></path>
      </svg>
      Back to projects
    </a>

    <div
      data-reveal
      class="mt-7 mb-2.5 text-[11px] font-bold uppercase tracking-[0.22em] text-accent"
    >
      {cs.eyebrow}
    </div>

    <h1
      data-reveal
      style="transition-delay: 70ms"
      class="m-0 mb-4 text-[28px] font-extrabold leading-[1.18] tracking-[-0.8px] sm:text-[38px]"
    >
      {cs.title}
    </h1>

    <p
      data-reveal
      style="transition-delay: 140ms"
      class="m-0 max-w-[660px] text-[15.5px] leading-[1.75] text-muted sm:text-[16.5px]"
    >
      {cs.lead}
    </p>

    <!-- ── Hero: the walkthrough clip ─────────────────────────────
         The link is the pill alone, not the whole clip: under reduced motion
         the script below gives the video real controls, and a wrapping anchor
         would turn every press of Play into a navigation. -->
    <figure data-reveal style="transition-delay: 210ms" class="m-0 mt-9">
      <div class="group relative overflow-hidden rounded-[16px] border border-line">
        <video
          data-case-hero
          data-rate={cs.hero.rate}
          src={cs.hero.video}
          poster={cs.hero.poster}
          width={cs.hero.posterWidth}
          height={cs.hero.posterHeight}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={cs.hero.label}
          class="block h-auto w-full"></video>

        <a
          href={cs.live}
          target="_blank"
          rel="noopener noreferrer"
          class="absolute bottom-3 left-3 inline-flex items-center gap-2 rounded-full border border-line bg-card/80 px-3.5 py-2 text-[13px] font-semibold text-fg no-underline backdrop-blur-[6px] transition-colors hover:border-accent group-hover:border-accent sm:bottom-4 sm:left-4"
        >
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          {liveHost}
          <span class="text-faint transition-colors group-hover:text-accent" aria-hidden="true">↗</span>
          <span class="sr-only">— opens the live site in a new tab</span>
        </a>
      </div>
      <figcaption class="mt-2.5 text-[11.5px] leading-[1.6] text-faint">
        {cs.hero.caption}
      </figcaption>
    </figure>

    <div data-reveal class={`mt-5 ${panelBase} px-4 py-5 sm:px-6`}>
      <div class="grid grid-cols-2 gap-x-3 gap-y-5 text-center sm:grid-cols-4">
        {
          cs.stats.map((s) => (
            <div>
              <div class="text-[20px] font-extrabold tracking-[-0.5px] sm:text-[24px]">
                {s.value}
              </div>
              <div class="mt-1 text-[12px] leading-tight text-faint">
                {s.label}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- ── Problem / Idea ─────────────────────────────────────── -->
    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        [cs.why, cs.goal].map((block, i) => (
          <section
            data-reveal
            style={`transition-delay: ${i * 90}ms`}
            class={panel}
          >
            <h2 class={panelLabel}>{block.label}</h2>
            <p class="m-0 text-[14.5px] leading-[1.7] text-muted">
              {block.body}
            </p>
          </section>
        ))
      }
    </div>

    <!-- ── Overview + what it does ────────────────────────────── -->
    <section data-reveal class={`mt-4 ${panel}`}>
      <h2 class="mb-5 text-[11px] font-bold uppercase tracking-[0.22em] text-accent">
        Project overview
      </h2>

      <dl class="m-0 grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4">
        {
          cs.overview.map((row) => (
            <div>
              <dt class="text-[10.5px] font-bold uppercase tracking-[0.16em] text-faint">
                {row.label}
              </dt>
              <dd class="m-0 mt-1.5 text-[14px] font-semibold leading-[1.45]">
                {row.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="my-6 h-px bg-line"></div>

      <h3 class={subLabel}>Why I built it</h3>
      <p class="m-0 text-[14px] leading-[1.7] text-muted">{cs.whyJev}</p>

      <div class="my-6 h-px bg-line"></div>

      <h3 class={subLabel}>How it was made</h3>
      <p class="m-0 text-[14px] leading-[1.7] text-muted">{cs.howItWasMade}</p>

      <div class="my-6 h-px bg-line"></div>

      <h3 class={subLabel}>What it does</h3>
      <ul class="m-0 grid list-none grid-cols-1 gap-2.5 p-0 sm:grid-cols-2">
        {
          cs.whatItDoes.map((item) => (
            <li class="flex gap-2.5 text-[14px] leading-[1.6] text-muted">
              <span
                class="mt-[9px] size-[3px] shrink-0 rounded-full bg-accent"
                aria-hidden="true"
              />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── How it works ───────────────────────────────────────────
         Real text rather than the brief's diagram image: at this column
         width the picture's labels would be a few pixels tall. -->
    <section class="mt-14">
      <h2 data-reveal class={sectionLabel}>How a town gets its tags</h2>

      <ol class="m-0 flex list-none flex-col gap-3 p-0">
        {
          cs.pipeline.stages.map((stage, i) => (
            <li data-reveal class={`${panelBase} p-5 sm:p-6`}>
              <div class="mb-2.5 flex items-baseline gap-3">
                <span class="text-[11px] font-bold tabular-nums tracking-[0.14em] text-accent">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-faint">
                  {stage.name}
                </span>
              </div>
              <h3 class="m-0 mb-3 text-[16px] font-bold tracking-[-0.2px] sm:text-[17px]">
                {stage.title}
              </h3>
              <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
                {stage.points.map((point) => (
                  <li class="flex gap-2.5 text-[14px] leading-[1.6] text-muted">
                    <span
                      class="mt-[9px] size-[3px] shrink-0 rounded-full bg-accent"
                      aria-hidden="true"
                    />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>

      <div
        data-reveal
        class="mt-4 rounded-[16px] border border-accent/25 bg-accent/[0.045] p-5 sm:p-7"
      >
        <h3 class="m-0 mb-2.5 text-[16.5px] font-extrabold leading-[1.35] tracking-[-0.3px] sm:text-[18px]">
          {cs.pipeline.rule}
        </h3>
        <p class="m-0 text-[14.5px] leading-[1.75] text-muted">
          {cs.pipeline.ruleBody}
        </p>
      </div>
    </section>

    <!-- ── Key screens ────────────────────────────────────────── -->
    <section class="mt-14">
      <h2 data-reveal class={`${sectionLabel} mb-4`}>Key screens</h2>

      <nav data-reveal aria-label="Jump to a key screen" class="mb-7">
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
          {cs.screens.map((screen) => (
            <li>
              <a
                href={`#${screen.id}`}
                class="inline-flex rounded-full border border-line bg-card px-3 py-1.5 text-[12.5px] font-medium text-muted no-underline transition-colors hover:border-accent hover:text-fg"
              >
                {screen.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        {cs.screens.map((screen) => <KeyScreenCard screen={screen} />)}
      </div>
    </section>

    <!-- ── Agreement with the reference set ───────────────────────
         Never headed "accuracy": see rule 2 at the top of the data file. -->
    <section class="mt-14">
      <h2 data-reveal class={sectionLabel}>How well the tags hold up</h2>

      <div data-reveal class={panel}>
        <p class="m-0 text-[14.5px] leading-[1.7] text-muted">
          {cs.agreement.intro}
        </p>

        <div class="mt-5 overflow-x-auto">
          <table class="w-full border-collapse text-left text-[13.5px]">
            <thead>
              <tr class="border-b border-line">
                <th scope="col" class="py-2.5 pr-3 text-[10.5px] font-bold uppercase tracking-[0.14em] text-faint">
                  Vibe
                </th>
                <th scope="col" class="py-2.5 pr-3 text-[10.5px] font-bold uppercase tracking-[0.14em] text-faint">
                  When the site says yes, it agrees
                </th>
                <th scope="col" class="py-2.5 text-[10.5px] font-bold uppercase tracking-[0.14em] text-faint">
                  Towns it catches
                </th>
              </tr>
            </thead>
            <tbody>
              {
                cs.agreement.rows.map((row) => (
                  <tr class="border-b border-line last:border-b-0">
                    <th scope="row" class="py-2.5 pr-3 font-semibold text-fg">
                      {row.vibe}
                      {row.under && (
                        <span class="ml-2 whitespace-nowrap rounded-full border border-line px-2 py-0.5 text-[10.5px] font-medium text-faint">
                          under the bar
                        </span>
                      )}
                    </th>
                    <td class="py-2.5 pr-3 tabular-nums text-fg">
                      {row.agrees}{" "}
                      <span class="whitespace-nowrap text-faint">({row.agreesOf})</span>
                    </td>
                    <td class="py-2.5 tabular-nums text-fg">
                      {row.catches}{" "}
                      <span class="whitespace-nowrap text-faint">({row.catchesOf})</span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <ul class="mt-5 mb-0 flex list-none flex-col gap-2 p-0">
          {
            cs.agreement.notes.map((note) => (
              <li class="flex gap-2.5 text-[14px] leading-[1.6] text-muted">
                <span
                  class="mt-[9px] size-[3px] shrink-0 rounded-full bg-accent"
                  aria-hidden="true"
                />
                <span>{note}</span>
              </li>
            ))
          }
        </ul>

        <p class="m-0 mt-5 text-[13px] text-faint">
          The same table, with every caveat, is on the site's{" "}
          <a
            href={cs.howItWorksUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-muted underline decoration-line underline-offset-4 hover:text-accent-hover"
            >How it works page<span class="sr-only"> (opens in a new tab)</span></a
          >.
        </p>
      </div>
    </section>

    <!-- ── Hard problems ──────────────────────────────────────── -->
    <section class="mt-14">
      <h2 data-reveal class={sectionLabel}>Hard problems</h2>
      <div class="flex flex-col gap-4">
        {
          cs.problems.map((card, i) => (
            <div
              data-reveal
              class="rounded-[16px] border border-accent/25 bg-accent/[0.045] p-5 sm:p-7"
            >
              <div class="mb-3 flex items-baseline gap-3">
                <span class="text-[11px] font-bold tabular-nums tracking-[0.14em] text-accent">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="m-0 text-[16.5px] font-extrabold leading-[1.35] tracking-[-0.3px] sm:text-[18px]">
                  {card.title}
                </h3>
              </div>
              <p class="m-0 text-[14.5px] leading-[1.75] text-muted sm:pl-[calc(1.5rem+8px)]">
                {card.body}
              </p>
            </div>
          ))
        }
      </div>

      <div data-reveal class={`mt-4 ${panel}`}>
        <h3 class={subLabel}>Tried and dropped</h3>
        <ul class="m-0 flex list-none flex-col gap-2 p-0">
          {
            cs.dropped.map((item) => (
              <li class="flex gap-2.5 text-[14px] leading-[1.6] text-muted">
                <span
                  class="mt-[9px] size-[3px] shrink-0 rounded-full bg-accent"
                  aria-hidden="true"
                />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ── Design ─────────────────────────────────────────────── -->
    <section class="mt-14">
      <h2 data-reveal class={sectionLabel}>The redesign</h2>

      <div data-reveal class={panel}>
        <p class="m-0 text-[14.5px] leading-[1.7] text-muted">{cs.design.why}</p>
        <ul class="mt-4 mb-0 flex list-none flex-col gap-2 p-0">
          {
            cs.design.rules.map((rule) => (
              <li class="flex gap-2.5 text-[14px] leading-[1.6] text-muted">
                <span
                  class="mt-[9px] size-[3px] shrink-0 rounded-full bg-accent"
                  aria-hidden="true"
                />
                <span>{rule}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-4 flex flex-col gap-4">
        {
          cs.design.pairs.map((pair, i) => (
            <div data-reveal class={panel}>
              <h3 class="m-0 mb-4 text-[15px] font-bold tracking-[-0.2px]">
                {pair.label}
              </h3>
              <div
                class={`grid grid-cols-2 gap-3 sm:gap-4 ${pair.phone ? "mx-auto max-w-[420px]" : ""}`}
              >
                {[
                  { tag: "Before", shot: pair.before },
                  { tag: "After", shot: pair.after },
                ].map((side) => (
                  <figure class="m-0">
                    <ZoomShot
                      shot={side.shot}
                      group={`redesign-${i}`}
                      sizes={
                        pair.phone
                          ? "(min-width: 640px) 200px, 44vw"
                          : "(min-width: 640px) 370px, 44vw"
                      }
                    />
                    <figcaption class="mt-2 text-[11px] font-bold uppercase tracking-[0.18em] text-faint">
                      {side.tag}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <p data-reveal class="m-0 mt-3 text-[12px] leading-[1.6] text-faint">
        {cs.design.pairNote}
      </p>

      <!-- Colours. The swatches are the product's own, so they are literal
           hex values rather than this site's theme tokens. -->
      <div data-reveal class={`mt-4 ${panel}`}>
        <h3 class={subLabel}>Each colour has one job</h3>
        <ul class="m-0 grid list-none grid-cols-1 gap-x-6 gap-y-3 p-0 sm:grid-cols-3">
          {
            cs.design.palette.map((c) => (
              <li class="flex items-center gap-3">
                <span
                  class="size-9 shrink-0 rounded-[6px] border border-line"
                  style={`background:${c.hex}`}
                  aria-hidden="true"
                />
                <span class="min-w-0 leading-tight">
                  <span class="block text-[13.5px] font-semibold text-fg">
                    {c.name}{" "}
                    <span class="font-mono text-[11.5px] font-normal text-faint">
                      {c.hex}
                    </span>
                  </span>
                  <span class="mt-0.5 block text-[12.5px] text-muted">{c.job}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Logo. On the product's own page grey in both themes: the wordmark
           is ink, and would vanish on this site's dark background. -->
      <div data-reveal class={`mt-4 ${panel}`}>
        <h3 class={subLabel}>The logo</h3>
        <div class="grid items-center gap-5 sm:grid-cols-[minmax(0,300px)_1fr]">
          <div
            class="flex items-center justify-center rounded-[10px] border border-line px-6 py-8"
            style="background:#EEF0F3"
          >
            <img
              src={cs.design.logo.src}
              alt={cs.design.logo.alt}
              width={cs.design.logo.width}
              height={cs.design.logo.height}
              loading="lazy"
              decoding="async"
              class="block h-auto w-full max-w-[230px]"
            />
          </div>
          <p class="m-0 text-[14.5px] leading-[1.7] text-muted">
            {cs.design.logo.body}
          </p>
        </div>
      </div>

      <div data-reveal class={`mt-4 ${panel}`}>
        <h3 class={subLabel}>Illustrations</h3>
        <p class="m-0 mb-4 text-[14.5px] leading-[1.7] text-muted">
          {cs.design.illustrations.body}
        </p>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          {
            cs.design.illustrations.items.map((item) => (
              <img
                src={item.src}
                alt={item.alt}
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
                class="block h-auto w-full rounded-[6px]"
              />
            ))
          }
        </div>
        <p class="m-0 mt-3 text-[12px] leading-[1.6] text-faint">
          {cs.design.illustrations.credit}
        </p>

        <div class="my-6 h-px bg-line"></div>

        <h3 class={subLabel}>Share images</h3>
        <p class="m-0 mb-4 text-[14.5px] leading-[1.7] text-muted">
          {cs.design.share.body}
        </p>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4">
          {
            cs.design.share.items.map((item) => (
              <ZoomShot shot={item} group="share" />
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── How I worked ───────────────────────────────────────── -->
    <section class="mt-14">
      <h2 data-reveal class={sectionLabel}>How I worked</h2>
      <div class="flex flex-col gap-4">
        {
          cs.process.map((card) => (
            <div data-reveal class={panel}>
              <h3 class="m-0 mb-2.5 text-[16px] font-bold tracking-[-0.2px] sm:text-[17px]">
                {card.title}
              </h3>
              <p class="m-0 text-[14.5px] leading-[1.75] text-muted">
                {card.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── Limits / next ──────────────────────────────────────── -->
    <section class="mt-14">
      <h2 data-reveal class={sectionLabel}>Limits and what's next</h2>
      <div class="grid gap-4 sm:grid-cols-[1.4fr_1fr]">
        {
          [
            { label: "Honest limits", items: cs.limits },
            { label: "What's next", items: cs.next },
          ].map((block, i) => (
            <div
              data-reveal
              style={`transition-delay: ${i * 90}ms`}
              class={panel}
            >
              <h3 class={panelLabel}>{block.label}</h3>
              <ul class="m-0 flex list-none flex-col gap-2 p-0">
                {block.items.map((item) => (
                  <li class="flex gap-2.5 text-[14px] leading-[1.6] text-muted">
                    <span
                      class="mt-[9px] size-[3px] shrink-0 rounded-full bg-accent"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── Tech stack ─────────────────────────────────────────── -->
    <section class="mt-14">
      <h2 data-reveal class={sectionLabel}>Tech stack</h2>
      <div data-reveal class={panel}>
        <div class="flex flex-wrap gap-2">
          {cs.stack.chips.map((chip) => <span class="tag">{chip}</span>)}
        </div>

        <p class="m-0 mt-5 text-[14.5px] leading-[1.7] text-muted">
          {cs.stack.body}
        </p>

        <div class="my-5 h-px bg-line"></div>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px] leading-[1.5]">
          {
            cs.stack.facts.map((fact, i) => (
              <Fragment>
                {i > 0 && (
                  <span class="text-faint" aria-hidden="true">
                    ·
                  </span>
                )}
                <span class="font-semibold text-fg">{fact}</span>
              </Fragment>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── Credits ────────────────────────────────────────────── -->
    <section class="mt-14">
      <h2 data-reveal class={sectionLabel}>Credits and licences</h2>
      <div data-reveal class={panel}>
        <ul class="m-0 flex list-none flex-col gap-2 p-0">
          {
            cs.licences.map((item) => (
              <li class="flex gap-2.5 text-[13.5px] leading-[1.6] text-muted">
                <span
                  class="mt-[9px] size-[3px] shrink-0 rounded-full bg-accent"
                  aria-hidden="true"
                />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <p class="m-0 mt-4 text-[13px] text-faint">
          Every article revision and photographer is listed on the site's{" "}
          <a
            href={cs.creditsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-muted underline decoration-line underline-offset-4 hover:text-accent-hover"
            >Credits page<span class="sr-only"> (opens in a new tab)</span></a
          >.
        </p>
      </div>
    </section>

    <!-- ── CTA ────────────────────────────────────────────────── -->
    <section class="mt-14">
      <div
        data-reveal
        class="rounded-[20px] border border-line bg-card p-6 text-center sm:p-9"
      >
        <h2
          class="m-0 mb-3 text-[21px] font-extrabold tracking-[-0.5px] sm:text-[25px]"
        >
          {cs.cta.title}
        </h2>
        <p
          class="mx-auto m-0 mb-6 max-w-[520px] text-[14.5px] leading-[1.7] text-muted"
        >
          {cs.cta.body}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="/#contact" class="btn-hover w-fit">
            <span class="btn-hover-idle">
              <span class="btn-hover-dot" aria-hidden="true"></span>
              <span class="btn-hover-idle-text">Let's talk</span>
            </span>
            <span class="btn-hover-reveal" aria-hidden="true">
              <span>Let's talk</span>
              <span>→</span>
            </span>
          </a>
          <a
            href={cs.live}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline btn-sm"
          >
            Open the map
          </a>
        </div>
      </div>
    </section>
  </article>

  <ZoomDialog />
</BaseLayout>

<script is:inline>
  // Play the clip at the speed the data file asks for. Both properties: a loop
  // keeps playbackRate, but a reload falls back to the default one.
  document.querySelectorAll("[data-case-hero][data-rate]").forEach((v) => {
    const rate = Number(v.dataset.rate);
    if (rate > 0) v.defaultPlaybackRate = v.playbackRate = rate;
  });

  // Don't loop an autoplaying clip at people who asked for less motion
  (function () {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.querySelectorAll("[data-case-hero]").forEach((v) => {
      v.autoplay = false;
      v.loop = false;
      v.controls = true;
      v.pause();
    });
  })();

  // Reveal each block as it arrives. One-shot: elements are unobserved once
  // shown, so nothing re-animates on the way back up a page this long.
  (function () {
    if (!document.documentElement.classList.contains("reveal-ready")) return;

    const targets = document.querySelectorAll("[data-reveal]");
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          io.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.04 },
    );

    targets.forEach((el) => io.observe(el));
  })();
</script>
