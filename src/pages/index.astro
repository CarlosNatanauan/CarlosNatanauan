---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import VerifiedBadge from "../components/VerifiedBadge.astro";
import SocialLinks from "../components/SocialLinks.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import ProjectCarousel from "../components/ProjectCarousel.astro";
import ExperienceRow from "../components/ExperienceRow.astro";
import ContactForm from "../components/ContactForm.astro";
import GitHubActivity from "../components/GitHubActivity.astro";
import ImageSlot from "../components/ImageSlot.astro";
import TodoNote from "../components/TodoNote.astro";
import TechChip from "../components/TechChip.astro";
import SectionNav from "../components/SectionNav.astro";
import PhotoStack from "../components/PhotoStack.astro";
import AvatarFlip from "../components/AvatarFlip.astro";

import { profile } from "../data/profile.js";
import { projects } from "../data/projects.js";
import { experience } from "../data/experience.js";
import { technologies } from "../data/technologies.js";
import { education } from "../data/education.js";
import { outside } from "../data/outside.js";

const featured = projects.find((p) => p.featured);
const gridProjects = projects.filter((p) => !p.featured);
---

<BaseLayout title="Kuya Carlos — Carlos Benedict Natanauan">
  <SectionNav />

  <!-- Hero / About -->
  <section class="col pt-7 pb-12 sm:pt-10 sm:pb-16">
    <!-- Portrait and name sit side by side at every width, with the social
         icons tucked under the name. -->
    <div class="mb-7 flex items-center gap-4 sm:gap-7">
      <AvatarFlip
        src={profile.avatar}
        alt={`Portrait of ${profile.name}`}
        altSrc={profile.avatarAlt}
        holdMs={profile.avatarAltHoldMs}
      />

      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h1 class="m-0 text-[22px] font-extrabold tracking-[-0.5px] sm:text-[32px]">
            {profile.name}
          </h1>
          {profile.verified && (
            <VerifiedBadge class="size-[18px] shrink-0 sm:size-[22px]" />
          )}
        </div>
        <SocialLinks class="mt-2.5" />
      </div>
    </div>

    <h2 class="m-0 mb-[18px] text-[27px] font-extrabold leading-[1.2] tracking-[-0.5px] sm:text-[34px]">
      {profile.headline}
      <span class="font-medium text-faint">{profile.headlineMuted}</span>
    </h2>

    <p class="m-0 mb-8 max-w-[640px] text-[16px] leading-[1.8] text-muted sm:text-[17px]">
      {
        profile.bio.map((seg) =>
          seg.tag ? (
            <TechChip
              name={seg.tag}
              icon={seg.icon}
              variant="inline"
              class="mx-0.5"
            />
          ) : (
            seg.text
          ),
        )
      }
    </p>

    <div class="flex flex-wrap gap-3.5">
      <a href="#contact" class="btn-solid">Let's Talk</a>
      <a href="#projects" class="btn-outline">See Projects</a>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="col py-12 sm:py-16">
    <SectionHeading
      eyebrow="Featured Work"
      title="Projects"
      intro="A collection of projects I've built — from full-stack applications to mobile experiences."
    />

    {featured && <FeaturedProject project={featured} />}

    <ProjectCarousel projects={gridProjects} />

    <div class="mt-9 text-center">
      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[14px] font-semibold text-muted hover:text-accent-hover"
        >View More on GitHub →</a
      >
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="col py-12 sm:py-16">
    <SectionHeading
      eyebrow="Career Journey"
      title="Experience"
      intro="Roles and internships where I learned, built, and shipped real products."
    />
    {experience.map((job) => <ExperienceRow job={job} />)}
  </section>

  <!-- Technologies -->
  <section id="technologies" class="col py-12 sm:py-16">
    <div class="mb-8 flex items-start justify-between gap-4">
      <div>
        <h2 class="m-0 text-[28px] font-extrabold tracking-[-0.5px] sm:text-[36px]">
          Tech I've Used
        </h2>
        <p class="mt-3 mb-0 max-w-[560px] text-[16px] text-muted">
          From the projects above, plus client apps I've shipped at work but
          can't show here.
        </p>
      </div>

      <button
        type="button"
        data-tech-toggle
        aria-pressed="false"
        aria-controls="tech-stack"
        title="Group by category"
        class="group mt-1 flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full border border-line bg-card text-muted transition-colors hover:border-accent hover:text-fg"
      >
        <!-- shown while compact: tap to group -->
        <svg
          class="size-[17px] group-aria-pressed:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="7" height="7" rx="1"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1"></rect>
          <rect x="14" y="14" width="7" height="7" rx="1"></rect>
        </svg>
        <!-- shown while grouped: tap to compact -->
        <svg
          class="hidden size-[17px] group-aria-pressed:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 2 9 5-9 5-9-5 9-5Z"></path>
          <path d="m3 12 9 5 9-5"></path>
          <path d="m3 17 9 5 9-5"></path>
        </svg>
        <span data-tech-toggle-label class="sr-only">Group by category</span>
      </button>
    </div>

    <div id="tech-stack" data-tech-stack class="tech-stack is-compact">
      {
        technologies.map((g) => (
          <div
            class="tech-row"
            style={`--marquee-dur:${g.items.length * 4.5}s`}
          >
            <div class="tech-label mb-2.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-faint">
              {g.group}
            </div>
            <div class="tech-track" data-tech-track>
              {g.items.map((t) => (
                <TechChip name={t.name} icon={t.icon} />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <script is:inline>
      (function () {
        const btn = document.querySelector("[data-tech-toggle]");
        const stack = document.querySelector("[data-tech-stack]");
        const label = document.querySelector("[data-tech-toggle-label]");
        if (!btn || !stack) return;

        // Duplicate each row's chips once so translateX(-50%) loops
        // seamlessly. Done here rather than in the HTML so the page ships a
        // single copy — the clones cost no bytes over the wire.
        stack.querySelectorAll("[data-tech-track]").forEach((track) => {
          Array.from(track.children).forEach((chip) => {
            const clone = chip.cloneNode(true);
            clone.setAttribute("aria-hidden", "true");
            clone.classList.add("tech-chip-clone");
            track.appendChild(clone);
          });
        });

        btn.addEventListener("click", () => {
          const grouped = stack.classList.toggle("is-compact") === false;
          btn.setAttribute("aria-pressed", grouped ? "true" : "false");
          const text = grouped ? "Show compact view" : "Group by category";
          btn.title = text;
          if (label) label.textContent = text;
        });
      })();
    </script>
  </section>

  <!-- Education -->
  <section id="education" class="col pt-12 sm:pt-16">
    <SectionHeading title="Education" />
    {
      education.length > 0 ? (
        education.map((e) => (
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-[160px_1fr] sm:gap-7">
            <div class="pt-0.5 text-[13.5px] text-faint">{e.years}</div>
            <div>
              <h3 class="m-0 mb-1.5 text-[18px] font-bold">{e.degree}</h3>
              <div class="text-[14.5px] text-muted">{e.school}</div>
              {e.campus && <div class="text-[14.5px] text-muted">{e.campus}</div>}
              {e.honors &&
                e.honors.map((h) => (
                  <div class="text-[14.5px] text-muted">{h}</div>
                ))}
            </div>
          </div>
        ))
      ) : (
        <TodoNote file="src/data/education.js">
          Add your education — years, degree, school, and campus / location.
        </TodoNote>
      )
    }
  </section>

  <!-- Outside the IDE -->
  <section
    id="outside"
    class="col grid grid-cols-1 items-center gap-8 py-12 sm:py-16 md:grid-cols-[1fr_260px] md:gap-12"
  >
    <div>
      <h2 class="m-0 mb-5 text-[28px] font-extrabold tracking-[-0.5px] sm:text-[36px]">
        {outside.heading}
      </h2>
      <p class="m-0 mb-6 max-w-[460px] text-[16px] leading-[1.7] text-muted">
        {outside.text}
      </p>
      {
        outside.strava && (
          <a
            href={outside.strava}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex w-fit items-center gap-3 rounded-full border border-line bg-card py-1.5 pr-5 pl-1.5 transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-0.5 hover:border-[#fc4c01]/50 hover:shadow-[0_8px_22px_rgb(252_76_1_/_0.20)]"
          >
            {/* Strava chevron in a brand-orange disc — from
                edent/SuperTinyIcons (MIT), tile swapped for a circle so it
                sits inside the pill. */}
            <span
              class="flex size-9 shrink-0 items-center justify-center rounded-full bg-[#fc4c01] transition-transform duration-200 group-hover:scale-105"
            >
              <svg
                class="size-[18px]"
                viewBox="0 0 512 512"
                role="img"
                aria-label="Strava"
              >
                <path fill="#fff" d="M192 288l40-96 40 96h72L232 56 120 288Z" />
                <path
                  fill="#ffc3a3"
                  d="M280 288l32 72 32-72h48l-80 168-80-168z"
                />
              </svg>
            </span>

            <span class="flex flex-col leading-tight">
              <span class="text-[10.5px] font-semibold uppercase tracking-[0.14em] text-faint">
                Strava
              </span>
              <span class="text-[14px] font-semibold text-fg">
                Let's follow each other
              </span>
            </span>

            <span
              class="ml-1 text-[15px] text-faint transition-transform duration-200 group-hover:translate-x-1 group-hover:text-[#fc4c01]"
              aria-hidden="true">→</span
            >
          </a>
        )
      }
    </div>

    <div class="justify-self-center">
      {
        outside.photos.length >= 2 ? (
          <PhotoStack photos={outside.photos} />
        ) : (
          <div class="h-[220px] w-[220px]">
            <ImageSlot
              placeholder="2 photos for the stacked photo pair"
              radius="rounded-[16px]"
            />
          </div>
        )
      }
    </div>
  </section>

  <!-- GitHub Activity -->
  <section id="github" class="col py-12 sm:py-16">
    <GitHubActivity />
  </section>

  <!-- Contact -->
  <section id="contact" class="col py-12 pb-16 sm:py-16 sm:pb-24">
    <SectionHeading
      eyebrow="Get In Touch"
      title="Contact"
      intro="Have a project in mind or just want to chat? Drop me a message and I'll get back to you soon!"
    />
    <ContactForm
      action="https://formspree.io/f/mldekgro"
      subject="New portfolio message!"
    />
  </section>
</BaseLayout>
