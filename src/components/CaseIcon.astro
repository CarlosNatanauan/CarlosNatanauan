---
// src/components/CaseIcon.astro — small stroke icons for the case study's
// key-screen cards. Same idiom as the icons already inline in BaseLayout and
// ProjectCarousel: 24x24 box, currentColor stroke, 2px, round caps.
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = "" } = Astro.props as Props;
---

<svg
  class={`h-[18px] w-[18px] shrink-0 ${className}`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "globe" && (
      <Fragment>
        <circle cx="12" cy="12" r="10" />
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        <path d="M2 12h20" />
      </Fragment>
    )
  }
  {
    name === "book" && (
      <Fragment>
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
      </Fragment>
    )
  }
  {
    name === "key" && (
      <Fragment>
        <circle cx="7.5" cy="15.5" r="4.5" />
        <path d="m21 2-10.3 10.3" />
        <path d="m15.5 7.5 3 3L21.5 7l-3-3" />
      </Fragment>
    )
  }
  {
    name === "gauge" && (
      <Fragment>
        <rect x="3" y="3" width="7" height="9" rx="1" />
        <rect x="14" y="3" width="7" height="5" rx="1" />
        <rect x="14" y="12" width="7" height="9" rx="1" />
        <rect x="3" y="16" width="7" height="5" rx="1" />
      </Fragment>
    )
  }
  {
    name === "images" && (
      <Fragment>
        <rect x="3" y="3" width="18" height="14" rx="2" />
        <circle cx="8.5" cy="8.5" r="1.5" />
        <path d="m21 13-4.5-4.5L7 18" />
        <path d="M7 21h14" />
      </Fragment>
    )
  }
  {
    name === "palette" && (
      <Fragment>
        <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.94 0 1.66-.76 1.66-1.7 0-.44-.18-.84-.44-1.13a1.6 1.6 0 0 1-.44-1.13 1.64 1.64 0 0 1 1.67-1.67h2C19.5 16.37 22 13.87 22 10.8 22 6 17.5 2 12 2z" />
        <circle cx="6.5" cy="12.5" r=".6" fill="currentColor" />
        <circle cx="9" cy="7.5" r=".6" fill="currentColor" />
        <circle cx="14.5" cy="7" r=".6" fill="currentColor" />
        <circle cx="17.5" cy="11" r=".6" fill="currentColor" />
      </Fragment>
    )
  }
  {
    name === "star" && (
      <path d="m12 2.5 2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.35l-5.81 3.05 1.11-6.47L2.6 9.35l6.5-.95z" />
    )
  }
  {
    name === "calendar" && (
      <Fragment>
        <rect x="3" y="4" width="18" height="17" rx="2" />
        <path d="M16 2v4M8 2v4M3 10h18" />
      </Fragment>
    )
  }
  {
    name === "inbox" && (
      <Fragment>
        <path d="M22 12h-6l-2 3h-4l-2-3H2" />
        <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
      </Fragment>
    )
  }
  {
    name === "chart" && (
      <Fragment>
        <path d="M3 3v18h18" />
        <path d="M7.5 17v-5M12 17V8.5M16.5 17v-8" />
      </Fragment>
    )
  }
  {
    name === "list" && <path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01" />
  }
  {
    name === "film" && (
      <Fragment>
        <rect x="2" y="4" width="20" height="16" rx="2" />
        <path d="M7 4v16M17 4v16M2 9.5h5M2 14.5h5M17 9.5h5M17 14.5h5" />
      </Fragment>
    )
  }
  {
    name === "sliders" && (
      <path d="M4 21v-6M4 11V3M12 21v-9M12 8V3M20 21v-4M20 13V3M1.5 15h5M9.5 8h5M17.5 17h5" />
    )
  }
  {
    name === "phone" && (
      <Fragment>
        <rect x="6" y="2" width="12" height="20" rx="2.5" />
        <path d="M12 18h.01" />
      </Fragment>
    )
  }
</svg>
