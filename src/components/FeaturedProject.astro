---
// src/components/FeaturedProject.astro — large featured card, Projects section
import fs from "node:fs";
import path from "node:path";
import ImageSlot from "./ImageSlot.astro";

interface TagGroup {
  label: string;
  tags: string[];
}
interface Project {
  name: string;
  tagline?: string;
  description: string;
  tagGroups?: TagGroup[];
  tech?: string[];
  image?: string;
  /** Screencast (.mp4 / .webm). Falls back to `image` until the file exists. */
  media?: string;
  /** Still frame shown before the clip plays */
  mediaPoster?: string;
  live?: string;
  demo?: string;
  repo?: string;
  /** Override the "Repo" button label, e.g. when it points at a backend repo */
  repoLabel?: string;
}
const { project } = Astro.props as { project: Project };

// Flat stack row — labelled groups are flattened if a project still has them
const tags: string[] =
  project.tech ?? project.tagGroups?.flatMap((g) => g.tags) ?? [];

const missingLinks = !project.live && !project.demo && !project.repo;

// The media links to the live site when there is one, else the repo
const imageHref = project.live || project.repo || "";

// Only treat the clip as present once the file is actually in /public, so the
// card degrades to the placeholder instead of a broken player.
function existsInPublic(src?: string) {
  if (!src || !src.startsWith("/")) return false;
  try {
    return fs.existsSync(path.join(process.cwd(), "public", src.slice(1)));
  } catch {
    return false;
  }
}

const videoSrc = existsInPublic(project.media) ? project.media : "";
const posterSrc = existsInPublic(project.mediaPoster) ? project.mediaPoster : "";
const MediaTag = imageHref ? "a" : "div";
const mediaProps = imageHref
  ? {
      href: imageHref,
      target: "_blank",
      rel: "noopener noreferrer",
      "aria-label": `Open ${project.name}`,
    }
  : {};
---

<section
  data-beam-card
  class="card-featured relative mb-14 w-full overflow-hidden rounded-[20px] border border-line bg-card"
>
  <!-- Beam travelling the border. Purely decorative and non-interactive; the
       mask below confines it to the 1px border ring. -->
  <div class="beam-track" aria-hidden="true">
    <div class="beam"></div>
  </div>
  <div class="grid grid-cols-1 gap-0 sm:grid-cols-[340px_1fr] sm:items-center">
  <!-- No backdrop: the clip sits directly on the card so it blends in both
       themes. Framed and vertically centred rather than full-bleed. -->
  <MediaTag
    class="group flex items-center justify-center p-5 sm:p-6"
    {...mediaProps}
  >
    {
      videoSrc ? (
        <video
          data-featured-video
          src={videoSrc}
          poster={posterSrc || undefined}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={`${project.name} website walkthrough`}
          class="block h-auto w-full rounded-[10px] border border-line shadow-[0_8px_24px_rgba(0,0,0,0.16)] transition-transform duration-500 group-hover:scale-[1.03] dark:shadow-[0_12px_32px_rgba(0,0,0,0.55)]"
        />
      ) : (
        <div class="aspect-[80/43] w-full">
          <ImageSlot
            src={project.image}
            alt={`${project.name} screenshot`}
            placeholder={`${project.name} screenshot`}
            radius="rounded-[10px]"
            loading="eager"
          />
        </div>
      )
    }
  </MediaTag>

  <div class="flex flex-col justify-center gap-4 p-6 sm:p-8">
    <div>
      <div
        class="mb-2.5 text-[11px] font-bold uppercase tracking-[0.22em] text-accent"
      >
        Featured Project
      </div>
      <h3 class="m-0 mb-2 text-[24px] font-extrabold tracking-[-0.5px] sm:text-[28px]">
        {project.name}
      </h3>
      <p class="m-0 max-w-[620px] text-[15px] leading-[1.65] text-muted">
        {project.description}
      </p>
    </div>

    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )
    }

    {
      missingLinks ? (
        <div class="todo">
          <span class="todo-label">To do</span>
          <div>
            Add the <strong>Live</strong> and <strong>Demo</strong> links for{" "}
            {project.name}.
          </div>
          <div class="mt-2 text-[12.5px] text-faint">
            Edit: <code>src/data/projects.js</code>
          </div>
        </div>
      ) : (
        <div class="flex flex-wrap items-center gap-3">
          {project.live && (
            <a
              href={project.live}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-hover w-fit"
            >
              <span class="btn-hover-idle">
                <span class="btn-hover-dot" aria-hidden="true"></span>
                <span class="btn-hover-idle-text">Visit Live Site</span>
              </span>
              <span class="btn-hover-reveal" aria-hidden="true">
                <span>Visit Live Site</span>
                <span>→</span>
              </span>
            </a>
          )}
          {project.demo && (
            <a
              href={project.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-outline btn-sm"
            >
              Demo
            </a>
          )}
          {project.repo && (
            <a
              href={project.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-outline btn-sm"
            >
              {project.repoLabel ?? "Repo"}
            </a>
          )}
        </div>
      )
    }
    </div>
  </div>
</section>

<style>
  /* The static border stays neutral (--tk-line is black at 9% in light,
     white at 10% in dark) so the beam is the only accent-coloured thing on
     the card. It earns its keep as structure, not decoration: bg-card and
     bg-bg are nearly identical in light mode (1.0 vs 0.985 lightness), so
     with no border at all the card would lose its shape entirely there. */

  /* ── border beam ──────────────────────────────────────────────
     A gradient square is walked around a rounded-rect motion path while a
     mask confines it to the border ring, so only the sliver crossing the
     border is ever visible — reading as a beam of light tracing the edge.

     Driven by `rotate` on a conic gradient rather than walking a square
     along offset-path. offset-distance is not a compositor-accelerated
     property, so it animates on the main thread — and this card contains an
     autoplaying looping video, whose frame decoding competes for exactly
     that thread and makes the beam hitch. `rotate` is composited: the
     gradient is painted once into a layer that the GPU then spins, so it
     stays smooth no matter how busy the main thread gets.

     Gated on @supports for the mask; without it the card simply keeps its
     static accent border. */
  .beam-track {
    display: none;
  }

  @supports (mask-composite: intersect) {
    .beam-track {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      border-radius: inherit;
      /* Transparent border of the same width as the card's: the ring this
         carves out is exactly the band the beam is allowed to paint in. */
      border: 1px solid transparent;

      /* Two mask layers intersected: the first is fully transparent and
         clipped to the padding box, the second fully opaque and clipped to
         the border box. What survives is border-box minus padding-box. */
      mask-image: linear-gradient(transparent, transparent),
        linear-gradient(#000, #000);
      mask-clip: padding-box, border-box;
      mask-composite: intersect;
    }

    .beam {
      position: absolute;
      top: 50%;
      left: 50%;
      /* Square, and wide enough that its inscribed circle still covers the
         card's corners at every angle — otherwise the sweep would visibly
         detach from the border on the diagonals. */
      width: 150%;
      aspect-ratio: 1;
      /* Separate `translate` so the centring is not clobbered by the
         `rotate` the animation drives — both are independent properties,
         and both are composited. */
      translate: -50% -50%;

      /* A long faint tail ramping into a solid head, so it reads as a beam
         with a trail rather than a rotating hard edge.

         Every stop is the accent at a different alpha — nothing is mixed
         toward white. Mixing with white desaturates as it lightens, which
         pulled the brightest part of the beam out of blue and read as an
         extra colour next to the accent already used on text. One hue,
         four opacities. */
      background: conic-gradient(
        from 0deg,
        transparent 0deg 250deg,
        color-mix(in oklch, var(--tk-accent) 22%, transparent) 320deg,
        color-mix(in oklch, var(--tk-accent) 62%, transparent) 348deg,
        var(--tk-accent) 358deg,
        transparent 360deg
      );
      /* --beam-ease is computed from the card's real aspect ratio at runtime
         (see below) and remaps time onto perimeter distance. Falls back to
         plain linear — visibly uneven, but never broken. */
      animation: card-beam 5s var(--beam-ease, linear) infinite;
      /* Promote up front rather than mid-animation */
      will-change: rotate;
    }

    @keyframes card-beam {
      to {
        rotate: 360deg;
      }
    }

    /* A perpetual loop is exactly what reduced motion is asking about.
       Removed outright — freezing it would leave a bright blob parked on
       one corner with no way to read it as intentional. */
    @media (prefers-reduced-motion: reduce) {
      .beam-track {
        display: none;
      }
    }
  }
</style>

<script is:inline>
  // Even out the border beam.
  //
  // A conic gradient sweeps by ANGLE, but it is tracing a RECTANGLE. The ray
  // from the centre meets the edge at y = a·tan(theta), so the contact point
  // travels at a·sec²(theta) — slowest at the middle of each edge, fastest
  // into the corners. On a wide card that is a large swing, and it reads as
  // the beam speeding up and slowing down.
  //
  // The fix is a timing function that maps elapsed time to perimeter
  // distance rather than to angle. Measured rather than hard-coded because
  // the card's aspect ratio changes with the viewport (and flips entirely
  // when the layout stacks on mobile). Runs on load and on resize only — the
  // animation itself stays pure CSS and stays on the compositor.
  (function () {
    const cards = document.querySelectorAll("[data-beam-card]");
    if (!cards.length) return;

    // Guard: if linear() is unsupported, leave the var unset so the CSS
    // fallback (plain `linear`) applies. Injecting an invalid timing
    // function would invalidate the whole animation shorthand and stop the
    // beam outright.
    if (
      !window.CSS ||
      !CSS.supports ||
      !CSS.supports("animation-timing-function", "linear(0, 1)")
    )
      return;

    const SAMPLES = 720; // around the perimeter
    const STOPS = 48; // control points emitted

    function easeFor(w, h) {
      if (!w || !h) return null;
      const a = w / 2;
      const b = h / 2;

      // Walk the perimeter at fine angular steps, accumulating arc length.
      const theta = new Array(SAMPLES + 1);
      const cum = new Array(SAMPLES + 1);
      let prevX = 0;
      let prevY = 0;
      let total = 0;

      for (let i = 0; i <= SAMPLES; i++) {
        const t = (i / SAMPLES) * Math.PI * 2;
        // 0deg points up and angle increases clockwise, matching both
        // conic-gradient(from 0deg) and a positive `rotate`.
        const dx = Math.sin(t);
        const dy = -Math.cos(t);
        const sx = Math.abs(dx) < 1e-9 ? Infinity : a / Math.abs(dx);
        const sy = Math.abs(dy) < 1e-9 ? Infinity : b / Math.abs(dy);
        const k = Math.min(sx, sy);
        const x = dx * k;
        const y = dy * k;
        if (i > 0) total += Math.hypot(x - prevX, y - prevY);
        theta[i] = t;
        cum[i] = total;
        prevX = x;
        prevY = y;
      }
      if (!total) return null;

      // Invert: for each evenly spaced slice of perimeter, find the angle
      // that reaches it. That angle (normalised) is the easing's output.
      const pts = [];
      let cursor = 0;
      for (let j = 0; j <= STOPS; j++) {
        const target = (j / STOPS) * total;
        while (cursor < SAMPLES && cum[cursor + 1] < target) cursor++;
        const lo = cum[cursor];
        const hi = cum[cursor + 1] != null ? cum[cursor + 1] : lo;
        const span = hi - lo;
        const frac = span > 0 ? (target - lo) / span : 0;
        const th =
          theta[cursor] +
          (theta[Math.min(cursor + 1, SAMPLES)] - theta[cursor]) * frac;
        pts.push(
          th / (Math.PI * 2) + " " + ((j / STOPS) * 100).toFixed(3) + "%",
        );
      }
      return "linear(" + pts.join(",") + ")";
    }

    function apply() {
      cards.forEach((card) => {
        const ease = easeFor(card.offsetWidth, card.offsetHeight);
        if (ease) card.style.setProperty("--beam-ease", ease);
      });
    }

    apply();
    // Cheap and rare; the geometry only changes when the box does.
    addEventListener("resize", apply, { passive: true });
  })();

  // Don't loop an autoplaying clip at people who asked for less motion
  (function () {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.querySelectorAll("[data-featured-video]").forEach((v) => {
      v.autoplay = false;
      v.loop = false;
      v.controls = true;
      v.pause();
    });
  })();
</script>
