---
// src/components/GitHubActivity.astro
// GitHub contribution heatmap, fetched in the browser on page load so it is
// always current.
//
// Why a proxy: GitHub's contribution calendar is NOT in the REST API — it only
// exists in the GraphQL API, which requires a token even for public data.
// github-contributions-api.jogruber.de makes that authenticated call for us and
// serves the result as CORS-open JSON, so no token ever touches this repo.
// If it is unreachable the section degrades to a link to the profile.
import { profile } from "../data/profile.js";

interface Props {
  username?: string;
  /** How many years to offer in the year switcher */
  years?: number;
}
const { username = profile.githubUsername, years = 3 } = Astro.props as Props;

const thisYear = new Date().getFullYear();
const yearList = Array.from({ length: years }, (_, i) => thisYear - i);
---

<section class="w-full" data-gh-activity data-user={username}>
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <h2 class="m-0 text-[28px] font-extrabold tracking-[-0.5px] sm:text-[36px]">
      GitHub Activity
    </h2>

    <div class="flex items-center gap-3">
      <p data-gh-total class="m-0 text-[13px] text-faint">Loading…</p>
      <div class="flex gap-1">
        {
          yearList.map((y, i) => (
            <button
              type="button"
              data-gh-year={y}
              aria-pressed={i === 0 ? "true" : "false"}
              class="rounded-full px-2.5 py-1 text-[12px] font-medium transition-colors text-muted hover:bg-fg/5 aria-pressed:bg-fg aria-pressed:text-bg"
            >
              {y}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="overflow-x-auto rounded-[16px] border border-line bg-card p-4 sm:p-5">
    <!-- min-height matches the rendered grid exactly (15px labels + 4px gap +
         88px of cells) so the loading state reserves space without leaving a
         gap once the data lands. -->
    <div data-gh-grid class="inline-flex min-h-[107px] flex-col gap-1">
      <p class="text-[13px] text-faint">Loading contributions…</p>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-end gap-1.5 text-[11px] text-faint">
    <span>Less</span>
    <span class="size-2.5 rounded-sm bg-fg/10"></span>
    <span class="size-2.5 rounded-sm bg-emerald-600/30 dark:bg-emerald-400/25"></span>
    <span class="size-2.5 rounded-sm bg-emerald-600/55 dark:bg-emerald-400/45"></span>
    <span class="size-2.5 rounded-sm bg-emerald-600/80 dark:bg-emerald-400/70"></span>
    <span class="size-2.5 rounded-sm bg-emerald-600 dark:bg-emerald-400"></span>
    <span>More</span>
  </div>
</section>

<script is:inline>
  (function () {
    const root = document.querySelector("[data-gh-activity]");
    if (!root) return;

    const user = root.dataset.user;
    const gridEl = root.querySelector("[data-gh-grid]");
    const totalEl = root.querySelector("[data-gh-total]");
    const yearBtns = Array.from(root.querySelectorAll("[data-gh-year]"));
    const cache = {};

    // Level 0-4 → colour, matching GitHub's green ramp in both themes
    const LEVELS = [
      "bg-fg/10",
      "bg-emerald-600/30 dark:bg-emerald-400/25",
      "bg-emerald-600/55 dark:bg-emerald-400/45",
      "bg-emerald-600/80 dark:bg-emerald-400/70",
      "bg-emerald-600 dark:bg-emerald-400",
    ];
    const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];

    function message(text, withLink) {
      gridEl.innerHTML = "";
      const p = document.createElement("p");
      p.className = "text-[13px] text-faint";
      p.textContent = text;
      gridEl.appendChild(p);
      if (withLink) {
        const a = document.createElement("a");
        a.href = "https://github.com/" + user;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.className = "text-[13px] font-semibold text-muted hover:text-accent-hover";
        a.textContent = "View my profile on GitHub →";
        gridEl.appendChild(a);
      }
    }

    function render(days) {
      // Bucket days into week columns, padding the first week so rows line up
      // with the real weekday (0 = Sunday).
      const weeks = [];
      let week = new Array(new Date(days[0].date + "T00:00:00").getDay()).fill(null);
      days.forEach((d) => {
        week.push(d);
        if (week.length === 7) {
          weeks.push(week);
          week = [];
        }
      });
      if (week.length) {
        while (week.length < 7) week.push(null);
        weeks.push(week);
      }

      gridEl.innerHTML = "";

      // Month labels — one per week column, shown when the month changes
      const labels = document.createElement("div");
      labels.className = "flex gap-[3px] text-[10px] text-faint";
      let lastMonth = -1;
      weeks.forEach((w) => {
        const first = w.find((d) => d);
        const cell = document.createElement("div");
        cell.className = "w-2.5 shrink-0";
        if (first) {
          const m = new Date(first.date + "T00:00:00").getMonth();
          if (m !== lastMonth) {
            cell.textContent = MONTHS[m];
            lastMonth = m;
          }
        }
        labels.appendChild(cell);
      });
      gridEl.appendChild(labels);

      const body = document.createElement("div");
      body.className = "flex gap-[3px]";
      weeks.forEach((w) => {
        const col = document.createElement("div");
        col.className = "flex flex-col gap-[3px]";
        w.forEach((d) => {
          const cell = document.createElement("div");
          if (!d) {
            cell.className = "w-2.5 h-2.5";
          } else {
            cell.className = "w-2.5 h-2.5 rounded-sm " + LEVELS[d.level || 0];
            cell.title =
              d.count + (d.count === 1 ? " contribution on " : " contributions on ") + d.date;
          }
          col.appendChild(cell);
        });
        body.appendChild(col);
      });
      gridEl.appendChild(body);
    }

    function select(year) {
      yearBtns.forEach((b) => {
        b.setAttribute("aria-pressed", b.dataset.ghYear === String(year) ? "true" : "false");
      });
      load(year);
    }

    async function load(year) {
      if (cache[year]) {
        totalEl.textContent = cache[year].total + " contributions";
        render(cache[year].days);
        return;
      }
      totalEl.textContent = "Loading…";
      try {
        const res = await fetch(
          "https://github-contributions-api.jogruber.de/v4/" +
            encodeURIComponent(user) +
            "?y=" +
            year,
        );
        if (!res.ok) throw new Error("HTTP " + res.status);
        const data = await res.json();
        const days = data.contributions || [];
        if (!days.length) throw new Error("no data");
        cache[year] = { total: (data.total && data.total[year]) || 0, days };
        totalEl.textContent = cache[year].total + " contributions";
        render(days);
      } catch (err) {
        totalEl.textContent = "";
        message("Couldn't load contributions right now.", true);
      }
    }

    yearBtns.forEach((b) => {
      b.addEventListener("click", () => select(Number(b.dataset.ghYear)));
    });

    load(Number(yearBtns[0].dataset.ghYear));
  })();
</script>
