---
// src/components/ContactForm.astro
import { profile } from "../data/profile.js";

interface Props {
  action?: string;
  subject?: string;
}
const {
  action = "https://formspree.io/f/mldekgro",
  subject = "New portfolio message!",
} = Astro.props as Props;

// Strip the mailto: wrapper so the address can be shown as text
const emailAddress = (profile.links.email || "")
  .replace(/^mailto:/, "")
  .split("?")[0];
---

<form
  id="contact-form"
  action={action}
  method="POST"
  class="w-full rounded-2xl border border-line bg-card p-4 sm:p-5"
>
  <!-- Name and email share a row on desktop; message spans both -->
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <div>
      <label
        for="name"
        class="mb-1 block text-[12px] font-semibold text-muted">Your Name</label
      >
      <input
        id="name"
        name="name"
        type="text"
        required
        autocomplete="name"
        placeholder="Jane Doe"
        class="field field-sm"
      />
    </div>

    <div>
      <label
        for="email"
        class="mb-1 block text-[12px] font-semibold text-muted">Your Email</label
      >
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@email.com"
        class="field field-sm"
      />
    </div>

    <div class="sm:col-span-2">
      <label
        for="message"
        class="mb-1 block text-[12px] font-semibold text-muted">Message</label
      >
      <textarea
        id="message"
        name="message"
        rows="3"
        required
        placeholder="Tell me about your project or just say hi!"
        class="field field-sm resize-y"></textarea>
    </div>
  </div>

  <input type="hidden" name="_subject" value={subject} />
  <input
    type="text"
    name="_gotcha"
    tabindex="-1"
    autocomplete="off"
    class="hidden"
    aria-hidden="true"
  />

  <!-- Actions: button left, live status beside it, direct email as a fallback -->
  <div
    class="mt-4 flex flex-col gap-3 border-t border-line pt-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex flex-wrap items-center gap-3">
      <button
        id="submit-btn"
        type="submit"
        class="group inline-flex items-center gap-1.5 rounded-lg border-none bg-fg px-5 py-2.5 text-[13.5px] font-bold text-bg transition-transform hover:scale-[1.03] disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:scale-100"
      >
        <span id="btn-label">Send Message</span>
        <span class="inline-block transition-transform group-hover:translate-x-1"
          >→</span
        >
      </button>
      <p id="form-status" class="m-0 text-[13px]" aria-live="polite"></p>
    </div>

    {
      emailAddress && (
        <a
          href={profile.links.email}
          class="inline-flex items-center gap-1.5 text-[13px] text-muted hover:text-accent-hover"
        >
          <svg
            class="size-3.5 shrink-0"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5L4 8V6l8 5 8-5z" />
          </svg>
          {emailAddress}
        </a>
      )
    }
  </div>
</form>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-form");
    const statusEl = document.getElementById("form-status");
    const btn = document.getElementById("submit-btn");
    const btnLabel = document.getElementById("btn-label");
    if (!form || !statusEl) return;

    function setStatus(msg, ok) {
      statusEl.textContent = msg;
      statusEl.style.color =
        ok === true
          ? "var(--tk-accent)"
          : ok === false
            ? "oklch(0.65 0.2 25)"
            : "var(--tk-muted)";
    }

    function setLoading(loading) {
      if (!btn || !btnLabel) return;
      btn.disabled = loading;
      btnLabel.textContent = loading ? "Sending…" : "Send Message";
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      setStatus("Sending your message…", null);
      setLoading(true);

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (res.ok) {
          form.reset();
          setStatus("Thanks! I'll get back to you soon.", true);
        } else {
          setStatus(
            "Something went wrong. Please try again or email me directly.",
            false,
          );
        }
      } catch {
        setStatus("Network error. Please check your connection.", false);
      } finally {
        setLoading(false);
      }
    });
  })();
</script>
