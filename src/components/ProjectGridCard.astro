---
// src/components/ProjectGridCard.astro
// A single project card — used as a slide inside ProjectCarousel.astro.
import ImageSlot from "./ImageSlot.astro";

interface Project {
  name: string;
  description: string;
  tech?: string[];
  image?: string;
  live?: string;
  repo?: string;
  demo?: string;
  tryIt?: string;
}
interface Props {
  project: Project;
  /** How many tags to show before collapsing the rest into "+N" */
  maxTags?: number;
}
const { project, maxTags = 4 } = Astro.props as Props;

const tech = project.tech ?? [];
const shown = tech.slice(0, maxTags);
const overflow = tech.length - shown.length;

// Footer links, in the order they should appear
const links = [
  { label: "Code", href: project.repo, icon: "github" },
  { label: "Live", href: project.live, icon: "external" },
  { label: "Demo", href: project.demo, icon: "play" },
  { label: "Try It", href: project.tryIt, icon: "download" },
].filter((l) => l.href);

const linkClass =
  "inline-flex items-center gap-1.5 rounded-md px-2 h-7 text-[12.5px] text-muted transition-colors hover:bg-fg/5 hover:text-fg";
---

<div
  class="group flex h-full flex-col overflow-hidden rounded-[16px] border border-line bg-card"
>
  <div class="relative aspect-[16/10] overflow-hidden bg-bg">
    <ImageSlot
      src={project.image}
      alt={`Screenshot of ${project.name}`}
      placeholder={`${project.name} screenshot`}
      radius="rounded-none"
      class="transition-transform duration-300 group-hover:scale-[1.03]"
    />
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <h3 class="m-0 text-[17px] font-bold">{project.name}</h3>
    <p class="m-0 flex-1 text-[13.5px] leading-[1.65] text-muted">
      {project.description}
    </p>

    {
      tech.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {shown.map((t) => (
            <span class="tag">{t}</span>
          ))}
          {overflow > 0 && <span class="tag">+{overflow}</span>}
        </div>
      )
    }

    {
      links.length > 0 ? (
        <div class="-ml-2 flex flex-wrap items-center gap-1 pt-1">
          {links.map((l) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class={linkClass}
              aria-label={`${l.label} — ${project.name}`}
            >
              {l.icon === "github" && (
                <svg
                  class="size-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                  <path d="M9 18c-4.51 2-5-2-7-2" />
                </svg>
              )}
              {l.icon === "external" && (
                <svg
                  class="size-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M15 3h6v6" />
                  <path d="M10 14 21 3" />
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                </svg>
              )}
              {l.icon === "play" && (
                <svg
                  class="size-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="m10 8 6 4-6 4V8" />
                </svg>
              )}
              {l.icon === "download" && (
                <svg
                  class="size-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <path d="M7 10l5 5 5-5" />
                  <path d="M12 15V3" />
                </svg>
              )}
              {l.label}
            </a>
          ))}
        </div>
      ) : (
        <div class="pt-1 text-[12px] font-semibold uppercase tracking-[0.5px] text-faint">
          Links to do
        </div>
      )
    }
  </div>
</div>
