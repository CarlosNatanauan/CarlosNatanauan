---
// src/components/ZoomDialog.astro — click-to-enlarge for the case study's
// screenshots. Include once per page; every [data-zoom] button on the page
// feeds this one dialog.
//
// Native <dialog> + showModal(), so the focus trap, Esc-to-close, background
// inertness and the ::backdrop are all the platform's job — no library, in
// keeping with the rest of this build.
//
// Stepping is scoped to one card's screenshots via data-zoom-group. The order
// inside a card is a sequence the copy depends on; the order across cards is
// not, and one card deliberately reuses another's shot as its payoff — so a
// page-wide sequence would show the same image twice under two captions.
//
// The enlarged file is only fetched when someone actually opens the dialog:
// the button carries its URL in data-full and nothing requests it until the
// src is assigned here.
---

<dialog data-zoom-dialog aria-label="Enlarged screenshot" class="zoom-dialog">
  <button
    type="button"
    data-zoom-close
    aria-label="Close enlarged screenshot"
    class="zoom-close"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </button>

  <figure class="zoom-figure">
    <div class="zoom-stage">
      <img data-zoom-img alt="" decoding="async" />

      <button
        type="button"
        data-zoom-prev
        aria-label="Previous screenshot"
        class="zoom-nav zoom-nav--prev"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m14 6-6 6 6 6"></path>
        </svg>
      </button>

      <button
        type="button"
        data-zoom-next
        aria-label="Next screenshot"
        class="zoom-nav zoom-nav--next"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m10 6 6 6-6 6"></path>
        </svg>
      </button>
    </div>

    <!-- polite, so stepping with the arrows announces the new screenshot
         instead of leaving a screen reader on the old description -->
    <figcaption class="zoom-caption" aria-live="polite">
      <span data-zoom-counter class="zoom-counter"></span>
      <span data-zoom-text></span>
    </figcaption>
  </figure>
</dialog>

<style>
  /* Deliberately not fullscreen: big enough to read the UI in the shot, small
     enough that the page is still visibly behind it. */
  .zoom-dialog {
    width: min(1100px, 92vw);
    max-width: min(1100px, 92vw);
    max-height: 88vh;
    padding: 0;
    /* Both explicit: a modal dialog is fixed to inset 0, and centring is the
       UA's `margin: auto` — which Tailwind's preflight zeroes out, leaving the
       dialog pinned to the top-left corner. */
    inset: 0;
    margin: auto;
    border: 1px solid var(--tk-line);
    border-radius: 16px;
    background: var(--tk-card);
    color: var(--tk-fg);
    overflow: visible;
  }

  /* Phone captures are 1284x2778. At the desktop width the shot would be a
     sliver stranded in the middle of a very wide panel, with the arrows an
     inch from the thing they step through. Every group is uniform in aspect,
     so this only ever changes between opens, never mid-sequence. */
  .zoom-dialog.is-portrait {
    width: min(520px, 92vw);
    max-width: min(520px, 92vw);
  }

  .zoom-dialog::backdrop {
    background: oklch(0 0 0 / 0.62);
    backdrop-filter: blur(2px);
  }

  .zoom-dialog:not([open]) {
    display: none;
  }

  .zoom-figure {
    margin: 0;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 88vh;
  }

  .zoom-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }

  .zoom-stage img {
    display: block;
    min-height: 0;
    /* auto on both axes so the width/height attributes set on open act as an
       aspect ratio rather than a fixed box: whichever max- rule bites first
       drives the other dimension, and wide desktop shots and tall phone ones
       both land right. */
    width: auto;
    height: auto;
    max-width: 100%;
    /* Room left for the figure's padding, the gap, and the caption. */
    max-height: calc(88vh - 112px);
    /* Whole screenshot, uncropped — the inline thumbnails crop to a fixed
       ratio, this is the one place the full frame is shown. */
    object-fit: contain;
    border-radius: 8px;
    border: 1px solid var(--tk-line);
  }

  /* Over the shot's edges rather than beside it: the dialog is sized to the
     image, so there is no gutter to put them in. Translucent and blurred so
     they stay legible over a light admin UI or a dark one. */
  .zoom-nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--tk-line);
    background: color-mix(in oklch, var(--tk-card) 82%, transparent);
    backdrop-filter: blur(6px);
    color: var(--tk-fg);
    cursor: pointer;
    transition:
      border-color 150ms ease,
      opacity 150ms ease;
  }
  .zoom-nav:hover {
    border-color: var(--tk-accent);
  }
  .zoom-nav svg {
    width: 18px;
    height: 18px;
  }
  .zoom-nav--prev {
    left: 10px;
  }
  .zoom-nav--next {
    right: 10px;
  }
  /* Hard stops at both ends — no wrap-around. Wrapping a two-shot group just
     flickers between the same pair. */
  .zoom-nav:disabled {
    opacity: 0.3;
    cursor: default;
  }
  /* Single-screenshot cards have nothing to step through */
  .zoom-nav[hidden] {
    display: none;
  }

  .zoom-caption {
    flex: none;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--tk-muted);
    text-align: center;
    padding-inline: 4px;
  }

  .zoom-counter {
    flex: none;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: 11.5px;
    color: var(--tk-faint);
  }
  .zoom-counter:empty {
    display: none;
  }

  /* Sits on the dialog's corner rather than over the screenshot, so it never
     covers part of what you opened the dialog to look at. */
  .zoom-close {
    position: absolute;
    top: -14px;
    right: -14px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--tk-line);
    background: var(--tk-card);
    color: var(--tk-fg);
    cursor: pointer;
    transition: border-color 150ms ease;
  }
  .zoom-close:hover {
    border-color: var(--tk-accent);
  }
  .zoom-close svg {
    width: 17px;
    height: 17px;
  }

  @media (max-width: 480px) {
    .zoom-close {
      top: 8px;
      right: 8px;
    }
    .zoom-nav {
      width: 32px;
      height: 32px;
    }
    .zoom-nav--prev {
      left: 6px;
    }
    .zoom-nav--next {
      right: 6px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .zoom-dialog[open] {
      animation: zoom-in 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes zoom-in {
      from {
        opacity: 0;
        scale: 0.97;
      }
    }
  }
</style>

<script>
  (function () {
    const dialog = document.querySelector<HTMLDialogElement>(
      "[data-zoom-dialog]",
    );
    if (!dialog || typeof dialog.showModal !== "function") return;

    const img = dialog.querySelector<HTMLImageElement>("[data-zoom-img]");
    const text = dialog.querySelector<HTMLElement>("[data-zoom-text]");
    const counter = dialog.querySelector<HTMLElement>("[data-zoom-counter]");
    const prev = dialog.querySelector<HTMLButtonElement>("[data-zoom-prev]");
    const next = dialog.querySelector<HTMLButtonElement>("[data-zoom-next]");
    const closeBtn = dialog.querySelector<HTMLButtonElement>("[data-zoom-close]");
    if (!img || !text || !counter || !prev || !next) return;

    /** The screenshots of the one card the dialog was opened from */
    let group: HTMLElement[] = [];
    let index = 0;
    /** Where the group started, so a closed dialog can leave the card in sync */
    let openedAt = 0;

    const show = (i: number) => {
      const trigger = group[i];
      if (!trigger || !trigger.dataset.full) return;
      index = i;

      // Dimensions before src: with both set, the browser knows the aspect
      // ratio up front and lays the dialog out at its final size instead of
      // growing into it once the file decodes.
      const w = Number(trigger.dataset.zoomW);
      const h = Number(trigger.dataset.zoomH);
      if (w && h) {
        img.width = w;
        img.height = h;
        dialog.classList.toggle("is-portrait", h > w);
      } else {
        img.removeAttribute("width");
        img.removeAttribute("height");
        dialog.classList.remove("is-portrait");
      }

      img.src = trigger.dataset.full;
      img.alt = trigger.dataset.zoomAlt || "";
      text.textContent = trigger.dataset.zoomAlt || "";
      counter.textContent =
        group.length > 1 ? `${i + 1} / ${group.length}` : "";

      const many = group.length > 1;
      prev.hidden = !many;
      next.hidden = !many;
      prev.disabled = i === 0;
      next.disabled = i === group.length - 1;

      // Warm the neighbours so stepping is instant rather than a blank beat.
      // Only the immediate ones — a 5-shot group should not cost 5 fetches
      // because someone opened the first.
      [group[i - 1], group[i + 1]].forEach((n) => {
        const url = n && n.dataset.full;
        if (url) new Image().src = url;
      });
    };

    const step = (delta: number) => {
      const target = index + delta;
      if (target < 0 || target >= group.length) return;
      show(target);
    };

    // Leave the card showing whatever the reader ended on. Without this the
    // carousel behind the dialog silently disagrees with what they just saw.
    const syncCardToIndex = () => {
      if (index === openedAt) return;
      const trigger = group[index];
      const track = trigger?.closest("[data-screen-carousel]")
        ?.querySelector<HTMLElement>("[data-screen-track]");
      if (!track) return; // the phone row is a grid, with nothing to scroll
      const slide = track.firstElementChild;
      if (!slide) return;
      const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
      const width = slide.getBoundingClientRect().width + gap;
      // Instant, not smooth: the dialog is closing over it and a glide would
      // be seen as the page moving on its own.
      track.scrollTo({ left: index * width, behavior: "auto" });
    };

    // Delegated, so carousel slides that are off-screen at load are covered
    // too and nothing needs re-binding.
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>("[data-zoom]");
      if (!trigger || !trigger.dataset.full) return;

      event.preventDefault();

      // Scope to the card this came from. DOM order is slide order.
      const name = trigger.dataset.zoomGroup;
      group = name
        ? Array.from(
            document.querySelectorAll<HTMLElement>(
              `[data-zoom][data-zoom-group="${name}"]`,
            ),
          )
        : [trigger];

      openedAt = Math.max(0, group.indexOf(trigger));
      show(openedAt);
      dialog.showModal();
    });

    prev.addEventListener("click", () => step(-1));
    next.addEventListener("click", () => step(1));

    // Arrow keys are what people reach for in a lightbox. Esc is the dialog's
    // own, so it is not handled here.
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        step(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        step(1);
      }
    });

    // Clicking the dialog itself means the padding around the figure — the
    // image, arrows and caption are children, so they never match.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    closeBtn?.addEventListener("click", () => dialog.close());

    dialog.addEventListener("close", () => {
      syncCardToIndex();
      // Drop the src so the decoded bitmap is released rather than held for
      // every screenshot the reader happens to have opened.
      img.removeAttribute("src");
      img.alt = "";
      text.textContent = "";
      counter.textContent = "";
      group = [];
    });
  })();
</script>
