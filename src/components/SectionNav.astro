---
// src/components/SectionNav.astro
// Fixed left-rail section navigator with cursor-proximity response.
//
// The React original eases each item with a rAF lerp loop. Registering
// --effect via @property makes it a real animatable value, so a plain CSS
// transition does the easing on the compositor and JS only sets a number.
const sections = [
  { id: "top", label: "Home" },
  { id: "projects", label: "Projects" },
  { id: "experience", label: "Experience" },
  { id: "technologies", label: "Tech" },
  { id: "education", label: "Education" },
  { id: "outside", label: "Outside" },
  { id: "github", label: "GitHub" },
  { id: "contact", label: "Contact" },
];
---

<nav class="line-nav" aria-label="Page sections" data-line-nav>
  <ul>
    {
      sections.map((s, i) => (
        <li>
          <a href={`#${s.id}`} data-nav-item data-target={s.id}>
            <span class="line-nav__marker" aria-hidden="true" />
            <span class="line-nav__index" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="line-nav__text">{s.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* Registering the property is what makes it transitionable */
  @property --effect {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  .line-nav {
    display: none;
  }

  /* Only shown once the side gutter is wide enough to hold it without
     crowding the 860px content column */
  @media (min-width: 1340px) {
    .line-nav {
      display: block;
      position: fixed;
      top: 50%;
      left: clamp(24px, calc(50vw - 430px - 190px), 72px);
      z-index: 30;
      transform: translateY(-50%);
    }
  }

  .line-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .line-nav a {
    --effect: 0;
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-left: 52px;
    text-decoration: none;
    font-size: 13.5px;
    line-height: 1.2;
    white-space: nowrap;
    color: color-mix(
      in oklch,
      var(--tk-accent) calc(var(--effect) * 100%),
      var(--tk-faint)
    );
    transform: translateX(calc(var(--effect) * 14px));
    transition:
      --effect 180ms linear,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Widen the pointer target so items react slightly before the cursor lands */
  .line-nav a::before {
    content: "";
    position: absolute;
    inset: -9px -40px -9px -52px;
  }

  .line-nav__index {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    opacity: calc(0.5 + var(--effect) * 0.5);
  }

  .line-nav__text {
    font-weight: 500;
  }

  /* Leading line — grows and takes on the accent as the cursor nears */
  .line-nav__marker {
    position: absolute;
    left: 0;
    top: 0.55em;
    height: 1px;
    width: 40px;
    transform-origin: left center;
    transform: scaleX(calc(0.55 + var(--effect) * 0.45));
    background-color: color-mix(
      in oklch,
      var(--tk-accent) calc(var(--effect) * 100%),
      var(--tk-line)
    );
  }

  /* Short tick sitting between each pair of items */
  .line-nav li:not(:last-child) a::after {
    content: "";
    position: absolute;
    left: 0;
    top: calc(100% + 9px);
    height: 1px;
    width: 20px;
    transform-origin: left center;
    transform: scaleX(calc(0.6 + var(--effect) * 0.4));
    background-color: var(--tk-line);
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .line-nav a {
      transition: none;
      transform: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const nav = document.querySelector("[data-line-nav]");
    if (!nav) return;
    const links = Array.from(nav.querySelectorAll("[data-nav-item]"));
    const RADIUS = 90; // px of vertical influence
    let activeIndex = -1; // -1 so the first sync always applies

    // smoothstep, same curve as the reference's "smooth" falloff
    const ease = (p) => p * p * (3 - 2 * p);

    function apply(effects) {
      links.forEach((a, i) => {
        const v = Math.max(effects[i] || 0, i === activeIndex ? 1 : 0);
        a.style.setProperty("--effect", v.toFixed(3));
      });
    }

    function clearProximity() {
      apply(links.map(() => 0));
    }

    nav.addEventListener("pointermove", (e) => {
      const effects = links.map((a) => {
        const r = a.getBoundingClientRect();
        const distance = Math.abs(e.clientY - (r.top + r.height / 2));
        return ease(Math.max(0, 1 - distance / RADIUS));
      });
      apply(effects);
    });
    nav.addEventListener("pointerleave", clearProximity);

    // Active section: the last one whose top has passed 40% of the viewport
    function syncActive() {
      const line = window.innerHeight * 0.4;
      let next = 0;
      links.forEach((a, i) => {
        const el = document.getElementById(a.dataset.target);
        if (el && el.getBoundingClientRect().top <= line) next = i;
      });
      if (next !== activeIndex) {
        activeIndex = next;
        links.forEach((a, i) =>
          i === activeIndex
            ? a.setAttribute("aria-current", "true")
            : a.removeAttribute("aria-current"),
        );
        clearProximity();
      }
    }

    // Run straight from the scroll event rather than deferring to rAF — nine
    // rect reads is cheap, and a deferred version silently does nothing if
    // frames aren't being produced.
    addEventListener("scroll", syncActive, { passive: true });
    addEventListener("resize", syncActive, { passive: true });

    syncActive();
    clearProximity();
  })();
</script>
