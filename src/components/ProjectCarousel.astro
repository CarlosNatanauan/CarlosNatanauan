---
// src/components/ProjectCarousel.astro
// Horizontal, scroll-snapped project carousel with prev/next buttons.
// Pure CSS scroll-snap + a small script — no carousel library.
import ProjectGridCard from "./ProjectGridCard.astro";

const { projects } = Astro.props as { projects: any[] };

const navBtn =
  "flex size-8 shrink-0 items-center justify-center rounded-full border border-line bg-card text-fg transition-colors hover:border-accent disabled:pointer-events-none disabled:opacity-40";
---

<div class="relative w-full" role="region" aria-roledescription="carousel" aria-label="Projects">
  <div
    data-carousel-track
    class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto pb-1"
    tabindex="0"
  >
    {
      projects.map((p) => (
        <div
          role="group"
          aria-roledescription="slide"
          class="min-w-0 shrink-0 grow-0 basis-[85%] snap-start sm:basis-[calc(50%-0.5rem)]"
        >
          <ProjectGridCard project={p} />
        </div>
      ))
    }
  </div>

  <div class="mt-4 flex items-center justify-end gap-2">
    <button type="button" data-carousel-prev class={navBtn} disabled>
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7"></path>
        <path d="M19 12H5"></path>
      </svg>
      <span class="sr-only">Previous slide</span>
    </button>
    <button type="button" data-carousel-next class={navBtn}>
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
      <span class="sr-only">Next slide</span>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll("[data-carousel-track]").forEach((track) => {
      const root = track.parentElement;
      if (!root) return;
      const prev = root.querySelector("[data-carousel-prev]");
      const next = root.querySelector("[data-carousel-next]");
      if (!prev || !next) return;

      // One card plus the gap between cards
      function step() {
        const slide = track.firstElementChild;
        if (!slide) return track.clientWidth;
        const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
        return slide.getBoundingClientRect().width + gap;
      }

      function sync() {
        const max = track.scrollWidth - track.clientWidth;
        prev.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft >= max - 1;
      }

      prev.addEventListener("click", () => {
        track.scrollBy({ left: -step(), behavior: "smooth" });
      });
      next.addEventListener("click", () => {
        track.scrollBy({ left: step(), behavior: "smooth" });
      });

      track.addEventListener("scroll", sync, { passive: true });
      addEventListener("resize", sync, { passive: true });
      sync();
    });
  })();
</script>
