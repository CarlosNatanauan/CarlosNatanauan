---
// src/components/ScrollTop.astro
// Floating "back to top" control, bottom-right. Appears once the visitor is
// far enough down that returning by scrolling would be tedious.
//
// Visual chrome deliberately matches the header's theme toggle so the two
// read as the same family of control. Sized to 44px rather than the header's
// 36px: this one floats over content with no neighbours to widen its target,
// and 44px is the minimum comfortable touch target.
---

<button
  type="button"
  data-scroll-top
  aria-label="Scroll back to top"
  title="Back to top"
  class="scroll-top flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-line bg-card text-fg hover:border-accent"
>
  <svg
    class="h-[18px] w-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</button>

<style>
  .scroll-top {
    position: fixed;
    /* Plain values first: a browser without env() support treats the max()
       declarations as invalid and drops them, falling back to these rather
       than leaving the button unpositioned. env() itself keeps it clear of
       the iOS home indicator. */
    right: 20px;
    bottom: 20px;
    right: max(20px, env(safe-area-inset-right, 0px));
    bottom: max(20px, calc(env(safe-area-inset-bottom, 0px) + 12px));
    /* Above the section rail (z-30), below the portrait dialog — which is in
       the top layer regardless, so it cannot be covered. */
    z-index: 40;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.28);

    /* Hidden state. visibility (not just opacity) is what keeps it out of the
       tab order while off-screen — an invisible but focusable button is a
       keyboard trap that lands focus on nothing. */
    visibility: hidden;
    opacity: 0;
    transform: translateY(10px) scale(0.92);
    transition:
      opacity 0.24s ease,
      transform 0.24s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.24s,
      border-color 0.2s ease;
  }

  .scroll-top.is-visible {
    visibility: visible;
    opacity: 1;
    transform: translateY(0) scale(1);
    /* Cancel the delay so it becomes visible at the start of the fade in,
       rather than after it */
    transition-delay: 0s;
  }

  .scroll-top:hover {
    transform: translateY(-2px) scale(1.04);
  }
  .scroll-top:active {
    transform: translateY(0) scale(0.96);
  }

  .scroll-top:focus-visible {
    outline: 2px solid var(--tk-accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-top {
      /* border-color stays — a colour change is not motion */
      transition:
        opacity 0.15s ease,
        visibility 0s linear 0.15s,
        border-color 0.2s ease;
      transform: none;
    }
    .scroll-top.is-visible,
    .scroll-top:hover,
    .scroll-top:active {
      transform: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const btn = document.querySelector("[data-scroll-top]");
    if (!btn) return;

    // Show once the first screenful is behind you — a fixed px threshold is
    // either too eager on a tall monitor or too shy on a phone.
    function sync() {
      const past = window.scrollY > window.innerHeight * 0.6;
      btn.classList.toggle("is-visible", past);
    }

    // Read straight from the event: scrollY is a single cheap read, and
    // deferring to rAF silently does nothing when frames aren't produced.
    addEventListener("scroll", sync, { passive: true });
    addEventListener("resize", sync, { passive: true });
    sync();

    btn.addEventListener("click", () => {
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      // "instant" rather than "auto": html carries scroll-smooth, and auto
      // would defer to that CSS and animate anyway.
      window.scrollTo({ top: 0, behavior: reduced ? "instant" : "smooth" });

      // Send focus back to the top too. Without this the page scrolls but
      // keyboard focus stays on a button at the bottom, so the next Tab
      // resumes from the footer — the visual and focus positions disagree.
      const top = document.getElementById("top");
      if (!top) return;
      top.setAttribute("tabindex", "-1");
      top.focus({ preventScroll: true });
      top.addEventListener("blur", () => top.removeAttribute("tabindex"), {
        once: true,
      });
    });
  })();
</script>
