---
import "../styles/global.css";
import { getImage } from "astro:assets";
import { profile } from "../data/profile.js";
import { experience } from "../data/experience.js";
import { technologies } from "../data/technologies.js";
import ScrollTop from "../components/ScrollTop.astro";

interface Props {
  title?: string;
  description?: string;
  /**
   * Prefix for the header's section links. Empty on the home page, where the
   * sections are on this page already; "/" on a sub-page, so the links point
   * back at the home page's sections instead of resolving to nothing.
   */
  navBase?: string;
  /** og:type — "profile" for the home page, "article" for a case study */
  ogType?: string;
  /** Social preview image, relative to the site root */
  ogImage?: string;
  /** Alt text for that preview. Falls back to the page title. */
  ogImageAlt?: string;
  /**
   * Pixel size of `ogImage`. Optional, but worth passing: some scrapers will
   * not render a preview on their first fetch without it. Both or neither.
   */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /**
   * "summary" crops to a small square — right for the portrait on the home
   * page, wrong for anything wide. Pass "summary_large_image" when the
   * preview image is a landscape screenshot.
   */
  twitterCard?: string;
  /** Skip the Person structured data on pages that are not about the person */
  personSchema?: boolean;
  /** Keep a page out of the index — the 404, and anything else with no
   *  reason to be a search result. */
  noindex?: boolean;
  /**
   * Structured data for pages that need their own. Assert only what the page
   * actually says — schema that outruns the page is the machine-readable
   * version of making things up.
   */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = "Carlos Natanauan — Portfolio",
  description = "Software developer focused on mobile app development with Flutter, branching into web with Astro.",
  navBase = "",
  ogType = "profile",
  ogImage = profile.avatar,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  twitterCard = "summary",
  personSchema: withPersonSchema = true,
  noindex = false,
  schema,
} = Astro.props as Props;

const year = new Date().getFullYear();

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// The portrait moved into src/assets, so it no longer has a stable public
// path — resolve it to its built file. JPEG, not WebP: this image exists
// only for link-preview scrapers, and their WebP support is still uneven.
const socialAssets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/profile/*.{png,jpg,jpeg}",
  { eager: true },
);
const ogAsset =
  socialAssets[`/src/assets/profile/${ogImage.slice(ogImage.lastIndexOf("/") + 1)}`]
    ?.default;
const ogGenerated = ogAsset
  ? await getImage({ src: ogAsset, format: "jpeg", width: 600, quality: 82 })
  : null;
const ogImageURL = new URL(ogGenerated?.src ?? ogImage, Astro.site);

// Scrapers are happier with explicit dimensions, and when this layout
// generated the file it knows them without the caller passing anything.
const ogWidth = ogImageWidth ?? ogGenerated?.attributes.width;
const ogHeight = ogImageHeight ?? ogGenerated?.attributes.height;

// Current role, for `worksFor`. The company field carries a location suffix
// after a bullet ("Creative Outline • Remote (UK)") that is not part of the
// organisation's name.
const currentRole = experience.find((job) => job.current);
const employer = currentRole?.company.split("•")[0].trim();

const personSchemaData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.fullName,
  jobTitle: profile.headline,
  description,
  image: ogImageURL.toString(),
  url: canonicalURL.toString(),
  email: profile.links.email.replace(/^mailto:/, "").split("?")[0],
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.address.locality,
    addressRegion: profile.address.region,
    addressCountry: profile.address.country,
  },
  ...(currentRole && {
    worksFor: {
      "@type": "Organization",
      name: employer,
      url: currentRole.companyUrl,
    },
  }),
  // Everything already listed on the page's tech section — asserting only
  // what the page itself backs up.
  knowsAbout: technologies.flatMap((row) => row.items.map((item) => item.name)),
  sameAs: Object.values(profile.links).filter((link) => link.startsWith("http")),
};

// One WebSite node per page, so search engines can name the site itself
// rather than inferring it from the title of whichever page they crawled.
const siteSchemaData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: profile.siteName,
  alternateName: `${profile.fullName} — Portfolio`,
  url: new URL("/", Astro.site).toString(),
  inLanguage: "en",
  author: { "@type": "Person", name: profile.fullName },
};
---

<html lang="en" class="scroll-smooth">
  <head>
    <!-- Theme resolved before first paint. Dark is the default. -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme"); // 'dark' | 'light' | null
        const isDark = stored ? stored === "dark" : true; // dark-mode-first
        const root = document.documentElement;
        root.classList.toggle("dark", isDark);
        root.style.colorScheme = isDark ? "dark" : "light";
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />
    <meta
      name="theme-color"
      content="#fbfbfc"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#26262b"
      media="(prefers-color-scheme: dark)"
    />

    <!-- Open Graph / social + search preview -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt ?? title} />
    {ogWidth && ogHeight && (
      <Fragment>
        <meta property="og:image:width" content={String(ogWidth)} />
        <meta property="og:image:height" content={String(ogHeight)} />
      </Fragment>
    )}
    {withPersonSchema && (
      <Fragment>
        <meta property="profile:first_name" content="Carlos" />
        <meta property="profile:last_name" content="Natanauan" />
      </Fragment>
    )}

    <!-- Twitter card -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? title} />

    <!-- Structured data: ties this portrait to "Carlos Natanauan" /
         "Carlos Benedict Natanauan" as one entity for Google -->
    {withPersonSchema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(personSchemaData)}
      />
    )}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(siteSchemaData)}
    />
    {schema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(schema)}
      />
    )}

    <!-- Same portrait as the hero. One image for both themes, so there is no
         theme-swap script here any more. Cropped to the face and downscaled
         to 128px: the browser fetches the whole file to draw a 16px tab
         icon, so pointing this at the full 753KB portrait would be wasteful. -->
    <link id="favicon" rel="icon" type="image/png" href="/favicon.png" />

    <title>{title}</title>
  </head>

  <body class="min-h-screen">
    <header
      class="sticky top-0 z-20 border-b border-line bg-header backdrop-blur-[10px]"
    >
      <div
        class="mx-auto flex max-w-[860px] items-center justify-between px-5 py-3.5 sm:px-12 sm:py-5"
      >
        <a
          href={navBase || "#top"}
          class="text-[16px] font-extrabold tracking-[0.5px] text-fg sm:text-[18px] hover:text-fg"
          >{profile.siteName}</a
        >

        <nav class="flex items-center gap-3 sm:gap-9">
          <!-- Desktop links -->
          <div class="hidden items-center gap-9 sm:flex">
            <a
              href={`${navBase}#projects`}
              class="text-[14px] font-medium text-muted hover:text-fg">Projects</a
            >
            <a
              href={`${navBase}#experience`}
              class="text-[14px] font-medium text-muted hover:text-fg">Experience</a
            >
            <a
              href={`${navBase}#contact`}
              class="text-[14px] font-medium text-muted hover:text-fg">Contact</a
            >
          </div>

          <button
            data-theme-toggle
            type="button"
            aria-label="Toggle color theme"
            aria-pressed="false"
            title="Toggle dark / light"
            class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full border border-line bg-card text-fg transition-colors hover:border-accent"
          >
            <!-- Sun: shown while dark mode is active (click → light) -->
            <svg
              class="hidden h-[17px] w-[17px] dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path>
            </svg>
            <!-- Moon: shown while light mode is active (click → dark) -->
            <svg
              class="h-[17px] w-[17px] dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
          </button>

          <!-- Mobile menu button -->
          <button
            id="menu-btn"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full border border-line bg-card text-fg transition-colors hover:border-accent sm:hidden"
          >
            <svg
              class="h-[17px] w-[17px]"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M4 6h16v2H4zM4 11h16v2H4zM4 16h16v2H4z"></path>
            </svg>
          </button>
        </nav>
      </div>

      <!-- Mobile menu panel -->
      <div
        id="mobile-menu"
        class="hidden border-t border-line bg-header px-5 py-2 sm:hidden"
      >
        <a
          href={`${navBase}#projects`}
          class="block rounded-lg py-2.5 text-[14px] font-medium text-muted hover:text-fg"
          >Projects</a
        >
        <a
          href={`${navBase}#experience`}
          class="block rounded-lg py-2.5 text-[14px] font-medium text-muted hover:text-fg"
          >Experience</a
        >
        <a
          href={`${navBase}#contact`}
          class="block rounded-lg py-2.5 text-[14px] font-medium text-muted hover:text-fg"
          >Contact</a
        >
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer
      class="border-t border-line px-5 py-8 text-center text-[13.5px] text-faint sm:px-12"
    >
      © {year} {profile.fullName}
    </footer>

    <ScrollTop />

    <!-- Analytics, loaded after the page is interactive rather than from
         <head>. gtag.js alone is ~100KB of third-party JavaScript; fetching
         it on the critical path competes with the page's own first paint for
         no benefit, since neither tool needs to run before the content does.
         Both still record the pageview. -->
    <script is:inline>
      (function () {
        let started = false;

        function load() {
          if (started) return;
          started = true;

          // GA4. dataLayer is a queue, so the config calls can be made
          // before the script that drains them has arrived.
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.gtag("js", new Date());
          window.gtag("config", "G-ZQW8V8K7VS");

          const ga = document.createElement("script");
          ga.async = true;
          ga.src = "https://www.googletagmanager.com/gtag/js?id=G-ZQW8V8K7VS";
          document.head.appendChild(ga);

          // GoatCounter reads the endpoint off its own tag and counts the
          // pageview as soon as it executes.
          const gc = document.createElement("script");
          gc.async = true;
          gc.dataset.goatcounter = "https://kuyacarlos.goatcounter.com/count";
          gc.src = "https://gc.zgo.at/count.js";
          document.head.appendChild(gc);
        }

        // Idle if the browser offers it, with a timeout so a permanently busy
        // page still reports; otherwise a beat after load. Either way the
        // visitor is counted before any realistic bounce.
        if ("requestIdleCallback" in window) {
          requestIdleCallback(load, { timeout: 4000 });
        } else {
          addEventListener("load", () => setTimeout(load, 1200));
        }
      })();
    </script>

    <script is:inline>
      (function () {
        let controller;

        function setUI(isDark) {
          document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
            btn.setAttribute("aria-pressed", isDark ? "true" : "false");
          });
        }

        function setTheme(isDark) {
          const root = document.documentElement;
          root.classList.toggle("dark", isDark);
          root.style.colorScheme = isDark ? "dark" : "light";
          localStorage.setItem("theme", isDark ? "dark" : "light");
          setUI(isDark);
        }

        const VT_DURATION = 450;

        function applyToggle() {
          setTheme(!document.documentElement.classList.contains("dark"));
          window.dispatchEvent(new Event("themechange"));
        }

        // Square View Transition wipe, expanding from the button. Falls back
        // to a plain toggle where the API is missing (Firefox < 144) or the
        // visitor asked for reduced motion.
        function toggleWithReveal(btn) {
          const root = document.documentElement;
          const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

          if (typeof document.startViewTransition !== "function" || reduced) {
            applyToggle();
            return;
          }

          const r = btn.getBoundingClientRect();
          const x = r.left + r.width / 2;
          const y = r.top + r.height / 2;
          // innerWidth/Height, not visualViewport: percentages resolve against
          // the snapshot reference box, which includes classic scrollbars.
          const vw = window.innerWidth;
          const vh = window.innerHeight;

          // Percentages, not px — Chrome mis-scales absolute clip-path
          // coordinates on fractional display scaling (e.g. Windows 150%).
          const toX = (v) => (v / vw) * 100 + "%";
          const toY = (v) => (v / vh) * 100 + "%";
          const point = (px, py) => toX(px) + " " + toY(py);

          // Square reveal. Half-side is the distance to the farthest edge on
          // either axis, so the square still covers the viewport when the
          // button sits in a corner; 1.05 is overscan against a seam on the
          // final frames.
          const half =
            Math.max(Math.max(x, vw - x), Math.max(y, vh - y)) * 1.05;

          // Both polygons need the same vertex count or they cannot
          // interpolate — the collapsed one is four points stacked on the
          // button's centre.
          const collapsed = new Array(4).fill(point(x, y)).join(", ");
          const expanded = [
            point(x - half, y - half),
            point(x + half, y - half),
            point(x + half, y + half),
            point(x - half, y + half),
          ].join(", ");
          const clipPath = [
            "polygon(" + collapsed + ")",
            "polygon(" + expanded + ")",
          ];

          root.dataset.themeVt = "active";
          root.style.setProperty("--theme-vt-duration", VT_DURATION + "ms");
          root.style.setProperty("--theme-vt-clip-from", clipPath[0]);

          const cleanup = () => {
            delete root.dataset.themeVt;
            root.style.removeProperty("--theme-vt-duration");
            root.style.removeProperty("--theme-vt-clip-from");
          };

          let transition;
          try {
            transition = document.startViewTransition(applyToggle);
          } catch (_) {
            applyToggle();
            cleanup();
            return;
          }

          // Never leave the page pinned mid-transition if a promise never settles
          const failsafe = setTimeout(cleanup, VT_DURATION + 1000);
          transition.finished
            .finally(() => {
              clearTimeout(failsafe);
              cleanup();
            })
            .catch(() => {});

          transition.ready
            .then(() => {
              root.animate(
                { clipPath },
                {
                  duration: VT_DURATION,
                  easing: "ease-in-out",
                  fill: "forwards",
                  pseudoElement: "::view-transition-new(root)",
                },
              );
            })
            .catch(() => {});
        }

        function bind() {
          controller?.abort();
          controller = new AbortController();
          setUI(document.documentElement.classList.contains("dark"));

          document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
            btn.addEventListener(
              "click",
              () => toggleWithReveal(btn),
              { signal: controller.signal, passive: true },
            );
          });
        }

        bind();
        addEventListener("astro:page-load", bind);
      })();
    </script>

    <script is:inline>
      (function () {
        const btn = document.getElementById("menu-btn");
        const panel = document.getElementById("mobile-menu");
        if (!btn || !panel) return;

        function close() {
          btn.setAttribute("aria-expanded", "false");
          panel.classList.add("hidden");
        }

        btn.addEventListener("click", () => {
          const open = btn.getAttribute("aria-expanded") === "true";
          btn.setAttribute("aria-expanded", String(!open));
          panel.classList.toggle("hidden", open);
        });

        panel.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", close);
        });

        addEventListener(
          "resize",
          () => {
            if (matchMedia("(min-width: 640px)").matches) close();
          },
          { passive: true },
        );
      })();
    </script>
  </body>
</html>
